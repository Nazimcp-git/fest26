{
  "rules": {
    "students": {
      ".read": true,
      ".write": "auth != null",
      "$studentId": {
        ".validate": "newData.hasChildren(['chestNo', 'name', 'teamId']) && newData.child('chestNo').isString() && newData.child('name').isString() && newData.child('teamId').isString()"
      }
    },

    "teams": {
      ".read": true,
      ".write": "auth != null",
      "$teamId": {
        ".validate": "newData.child('name').isString()"
      }
    },

    "programs": {
      ".read": true,
      ".write": "auth != null",
      "$programId": {
        ".validate": "newData.child('name').isString() && newData.child('category').isString()"
      }
    },

    "results": {
      ".indexOn": ["status"],
      ".read": "auth != null || (query.orderByChild == 'status' && query.equalTo == 'published')",
      ".write": "auth != null",
      "$resultId": {
        ".validate": "newData.hasChildren(['programId', 'programName', 'status'])",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'ready' || newData.val() === 'published')"
        },
        "participants": {
          "$participantIndex": {
            ".validate": "newData.hasChildren(['studentId', 'name'])"
          }
        }
      }
    },

    "pointsConfig": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['first', 'second', 'third'])"
    },

    "groupPointsConfig": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['first', 'second', 'third'])"
    },

    "teamPointsConfig": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['first', 'second', 'third'])"
    },

    "teamDirectScores": {
      ".read": true,
      ".write": "auth != null",
      "$teamId": {
        "$category": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "teamPenalties": {
      ".read": true,
      ".write": "auth != null",
      "$penaltyId": {
        ".validate": "newData.hasChildren(['teamId', 'points', 'reason']) && newData.child('points').isNumber() && newData.child('points').val() > 0"
      }
    },

    "studentPenalties": {
      ".read": true,
      ".write": true,
      "$penaltyId": {
        ".validate": "newData.hasChildren(['studentId', 'points', 'reason']) && newData.child('points').isNumber() && newData.child('points').val() > 0"
      }
    },

    "participantRegistrations": {
      ".read": true,
      ".write": true,
      "$programId": {
        "$teamId": {
          ".validate": "true"
        }
      }
    },

    "registrations": {
      ".read": true,
      ".write": true
    },

    "registrationPrograms": {
      ".read": true,
      ".write": true,
      "$programId": {
        ".validate": "newData.isBoolean()"
      }
    },

    "registrationProgramss": {
      ".read": true,
      ".write": true,
      "$programId": {
        ".validate": "newData.isBoolean()"
      }
    },

    "notifications": {
      ".read": true,
      ".write": true,
      "$notificationId": {
        ".validate": "newData.hasChildren(['type', 'timestamp'])"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
